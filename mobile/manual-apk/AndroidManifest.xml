<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.printpixrushid.app"
    android:versionCode="2"
    android:versionName="1.1.0">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PrintPix Rush ID"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name="com.printpixrushid.app.MainActivity"
            android:exported="true"
            android:label="PrintPix Rush ID"
            android:theme="@style/AppTheme"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
